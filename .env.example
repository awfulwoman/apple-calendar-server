# Bearer token(s) accepted on every endpoint (comma-separated, one per client).
# Leave unset to disable auth (server refuses all requests with 401 rather than
# running open).
CALENDAR_SERVER_BEARER_TOKENS=client-token

# Sidecar SQLite: maps a caller's own ids to EventKit's calendarItemIdentifier and
# tracks app-authoritative updated_at + tombstones (see store.py docstring).
CALENDAR_SERVER_DB_PATH=~/.local/state/apple-calendar-server/meta.db

# Calendar (EKCalendar) used when an event doesn't specify one.
CALENDAR_SERVER_DEFAULT_CALENDAR=Calendar

# Default window for GET /events when the client sends no start/end. Events must
# be fetched over a bounded range (EventKit has no "all events" query).
CALENDAR_SERVER_DEFAULT_WINDOW_PAST_DAYS=30
CALENDAR_SERVER_DEFAULT_WINDOW_FUTURE_DAYS=365

CALENDAR_SERVER_HOST=127.0.0.1
CALENDAR_SERVER_PORT=4101
